desc=Ryoku sobre niri (kernel mainline)
overlay=ryoku-n
overlay2=ryoku-common
packages=PACKAGES_RYOKU_N
kernel=linux-mainline
dm=emptty
arch=x86_64
iso=nekovoid-ryoku-n
# Sin TLP: es excluyente con power-profiles-daemon, que trae ryoku-desktop
# (la politica de energia y tapa la lleva Ryoku). Y turnstiled, que es el que
# supervisa los servicios de sesion del usuario (~/.config/service).
services=dbus elogind NetworkManager polkitd rtkit sshd chronyd zramen power-profiles-daemon turnstiled ryoku-var-state ryoku-boot-guard
postsetup=postsetup-ryoku.sh
