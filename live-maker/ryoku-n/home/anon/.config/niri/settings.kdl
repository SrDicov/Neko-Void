// Generated by Ryoku Settings (Super + ,). Edit in the GUI, not here.

input {
    keyboard {
        xkb {
            layout "us"
        }
        repeat-rate 25
        repeat-delay 600
    }
    touchpad {
        tap
        natural-scroll
        dwt
        drag true
        click-method "clickfinger"
    }
    mouse {
    }
    focus-follows-mouse max-scroll-amount="0%"
}

layout {
    gaps 16
    default-column-width { proportion 0.5; }
    center-focused-column "never"
    always-center-single-column
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    preset-window-heights {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    border {
        on
        width 4
        active-color "#e0563b"
        inactive-color "#313a4d"
        urgent-color "#9b0000"
    }
    focus-ring {
        off
    }
    shadow {
        on
        softness 45
        spread 0
        offset x=0 y=5
        color "#000000"
    }
    tab-indicator {
        width 4
        hide-when-single-tab
    }
}

cursor {
    xcursor-theme "Bibata-Modern-Ice"
    xcursor-size 24
}

prefer-no-csd

hotkey-overlay {
    skip-at-startup
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

gestures {
    hot-corners {
        off
    }
}

overview {
    zoom 0.5
}

window-rule {
    match title="^Welcome to Ryoku$"
    open-floating true
    default-column-width { fixed 1180; }
    default-window-height { fixed 760; }
}

window-rule {
    match title="^Rashin$"
    open-floating true
    default-column-width { fixed 1280; }
    default-window-height { fixed 820; }
}

window-rule {
    match title="^ryoku-phone-.*$"
    open-floating true
    default-column-width { fixed 520; }
    default-window-height { fixed 860; }
}

window-rule {
    match app-id="ryoport_console"
    open-floating true
}

window-rule {
    match app-id="(v|V)ncviewer"
    open-floating true
}

layer-rule {
    match namespace="ryoku-overview-backdrop"
    place-within-backdrop true
}

